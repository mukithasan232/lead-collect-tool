{
  "framework": null,
  "buildCommand": "echo 'Static site - no build step required'",
  "outputDirectory": ".",
  "routes": [
    { "src": "/dashboard",      "dest": "/dashboard.html" },
    { "src": "/dashboard.html", "dest": "/dashboard.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)",           "dest": "/index.html" }
  ]
}
