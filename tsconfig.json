{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "rootDir": "./server/src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["server/src/**/*"],
  "exclude": ["node_modules", "server/node_modules", "server/dist"]
}
