NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,https://lead-collect-tool-mu.vercel.app,https://app.codernest.cloud

# PostgreSQL Connection String (Transaction pooler for Supabase / Neon in production)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/leadpulse_db?schema=public"

# Direct URL for Prisma migrations (Session mode)
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/leadpulse_db"

# Redis Connection URL (Upstash TLS URL recommended for production)
REDIS_URL="rediss://default:your_token@your-cluster.upstash.io:6379"

# B2B Data Enrichment API Keys
NUBELA_API_KEY="your_ninjapear_or_proxycurl_api_key_here"
PROXYCURL_API_KEY="your_ninjapear_or_proxycurl_api_key_here"
PDL_API_KEY="your_people_data_labs_api_key_here"
APOLLO_API_KEY="your_apollo_api_key_here"

# Gemini AI for Nova Agent
GEMINI_API_KEY=""
